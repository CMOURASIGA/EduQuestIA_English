# OPENAI_API_KEY: Required for the tutor and writing-feedback APIs. Configure it in the hosting provider, never in the frontend.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# Optional. gpt-4.1-mini is the economical default for short tutoring and corrections.
OPENAI_MODEL="gpt-4.1-mini"

# Catálogo pedagógico compartilhado com o Terravox. Use apenas no servidor/Vercel.
# As credenciais não podem receber o prefixo VITE_.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SUA_SERVICE_ROLE_KEY"

# Protege os endpoints de importação/revisão/publicação de conteúdo pedagógico
# (api/admin-content-*). Use um valor longo e aleatório; quem tiver esse
# segredo consegue gravar rascunhos no catálogo compartilhado com o Terravox.
ADMIN_API_SECRET="UM_SEGREDO_FORTE_E_ALEATORIO"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EduQuest Support / Pix Configuration
VITE_PIX_ENABLED=false
VITE_PIX_KEY=""
VITE_PIX_COPY_PASTE=""
VITE_PIX_RECEIVER_NAME=""
VITE_PIX_RECEIVER_CITY=""
VITE_PIX_DEFAULT_AMOUNT=2.00
VITE_PIX_DESCRIPTION="APOIO EDUQUEST"
VITE_SUPPORTER_BADGE_ENABLED=true
VITE_APP_PUBLIC_URL=http://localhost:3000
